# Local environment for the API, the BFF and compose.yaml.
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be
# committed; this example carries names and placeholders only. Compose reads
# `.env` on its own, and so does infra/scripts/run-local.sh. For a bare JVM run,
# `set -a; . ./.env; set +a` first.

# --- Operational database (compose service `postgres`, host port 5432) ---
APP_DB_URL=jdbc:postgresql://localhost:5432/app
APP_DB_USERNAME=app
# No committed value. Pick any local password; run-local.sh refuses the
# placeholder. The Postgres volume keeps it, so changing it later needs
# `docker compose down -v`.
APP_DB_PASSWORD=change-me

# --- API authentication ---
# jwt (the default) validates bearer tokens from APP_AUTH_ISSUER_URI.
# dev-token accepts one pre-shared bearer instead; local development only, and
# refused under the `prod` Spring profile.
APP_AUTH_MODE=dev-token
# Leave empty for run-local.sh, which generates a fresh token on every run.
# Compose's `app` profile needs one here: `openssl rand -hex 24`.
APP_AUTH_DEV_TOKEN=
# Only read in jwt mode.
# APP_AUTH_ISSUER_URI=https://idp.example.com/realms/app
# APP_AUTH_ROLES_CLAIM=roles

# --- API HTTP exposure. Loopback-only and CORS off by default. A container
# must bind 0.0.0.0; CORS is only needed when the browser calls the API from
# another origin, which the BFF makes unnecessary. ---
# APP_SERVER_ADDRESS=0.0.0.0
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- BFF ---
APP_BFF_API_BASE_URL=http://localhost:8080
# oidc (the default) runs the authorization-code login against the IdP below.
# dev injects APP_AUTH_DEV_TOKEN into every proxied call; local only.
APP_BFF_AUTH_MODE=dev
# Only read in oidc mode. Never commit a real client secret.
# APP_OIDC_ISSUER_URI=https://idp.example.com/realms/app
# APP_OIDC_CLIENT_ID=app-portal
# APP_OIDC_CLIENT_SECRET=
# The origin browsers use, when the edge does not forward the public host
# (CloudFront). Blank derives it from the request.
# APP_BFF_PUBLIC_BASE_URL=https://app.example.com
# The session cookie is Secure by default; set false to try oidc mode over
# plain http://localhost.
# APP_BFF_SECURE_COOKIES=false

# --- Both JVMs ---
# APP_LOG_LEVEL=INFO
# `dev` enables Swagger UI on the API; `prod` refuses dev-token mode.
# SPRING_PROFILES_ACTIVE=dev
