# Secret-scan self-test fixture — VIOLATION cases.
#
# This file is intentionally allowlisted in secret-scan-allowlist.conf.
# It exists only to prove that the scanner catches literal assignments;
# none of the values below are real credentials.
#
# The self-test step in .github/workflows/build.yaml reads this file and expects the
# scanner to flag every line (one per supported syntax).

# Shell / env-file style (Pattern A — *PASSWORD* unquoted)
APP_DB_PASSWORD=selftest-planted-literal
POSTGRES_PASSWORD=selftest-planted-literal

# Properties style (Pattern A — *PASSWORD* dotted key)
spring.datasource.password=selftest-planted-literal

# Shell / env-file style (Pattern A2 — *PASSWD* unquoted)
POSTGRES_PASSWD=selftest-planted-literal

# YAML / Docker Compose style (Pattern B — password: value)
password: selftest-planted-literal

# YAML style (Pattern B_PASSWD — passwd: value)
passwd: selftest-planted-literal

# YAML style (Pattern B_PWD — pwd: value, lowercase)
pwd: selftest-planted-literal

# JSON style (Pattern B2 — "password": "value")
"password": "selftest-planted-literal"
