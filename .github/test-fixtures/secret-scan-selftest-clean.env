# Secret-scan self-test fixture — CLEAN cases.
#
# These shapes must NOT be flagged by the scanner.  This file is NOT in the
# allowlist — it must pass the main scan on its own, with no suppression.
#
# The self-test step in .github/workflows/build.yaml runs the patterns and post-filters
# against this file and expects zero findings.

# --- Env references (not matched at pattern level: value starts with $) ---

# Unquoted env reference — Spring Boot application.yml style
spring.datasource.password=${APP_DB_PASSWORD:}

# Env reference with default — Docker Compose style
POSTGRES_PASSWORD=${APP_OTHER_PASSWORD:-local-default}

# Mandatory env reference — Docker Compose :? form
POSTGRES_PASSWORD=${APP_DB_PASSWORD:?Set APP_DB_PASSWORD}

# --- Quoted env references (matched by Pattern A, removed by filter 1) ---

# Double-quoted env reference — shell assignment to forward a value
APP_DB_PASSWORD="$APP_DB_PASSWORD"

# Single-quoted env reference
APP_DB_PASSWORD='$APP_DB_PASSWORD'

# YAML value quoted around an env reference
password: "${APP_DB_PASSWORD:}"

# --- Source identifiers (matched by Pattern A/B, removed by filters 2–5) ---

# Method call as value (filter 3 — value contains '(')
String resolvedPassword = resolver.resolve(conn.password());

# Method call with argument (filter 3)
String password = optionalString(conn, "password");

# Bare identifier ending in ; (filter 5)
this.password = password;

# Double-equals comparison, not an assignment (filter 4)
password == null

# --- TypeScript form-state shapes (filters 7–8) ---
# A password field in a form: its type annotation and its cleared value are
# code, not credentials.

# Type annotation as value (filter 8)
password: string;

# Empty string literal — the field's initial and post-save value (filter 7)
password: "";

# The same, inside a state update
setForm((prev) => (prev.password ? { ...prev, password: "" } : prev));
