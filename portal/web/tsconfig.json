{
  // The browser code. Node's types are deliberately absent, so a module under
  // src/ cannot reach for Node globals; the Node-side files (Playwright suites,
  // the Vite config) are `tsconfig.node.json`'s. `npm run typecheck` compiles
  // both projects.
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vitest/globals"],
    // `@/<layer>/<slice>` for every import that crosses a slice or a layer
    // (ADR-027). Vite and Vitest resolve the same alias (vite.config.ts), and
    // ESLint through eslint-import-resolver-typescript, which reads this file.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
