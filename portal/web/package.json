{
  "name": "app-portal-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Portal SPA (React, MUI, React Query), served same-origin behind the Spring BFF.",
  "scripts": {
    "generate:api": "openapi-typescript ../../docs/arch/api-layer/portal-api-v1.yaml -o src/api/portal-api.d.ts",
    "dev": "vite",
    "prebuild": "npm run generate:api",
    "build": "tsc --noEmit && vite build",
    "pretest": "npm run generate:api",
    "test": "vitest run",
    "pretest:coverage": "npm run generate:api && npm run typecheck",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:a11y": "playwright test --project=a11y",
    "test:journey": "playwright test --project=journey",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@emotion/react": "11.13.3",
    "@emotion/styled": "11.13.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@mui/icons-material": "5.16.7",
    "@mui/material": "5.16.7",
    "@tanstack/react-query": "5.56.2",
    "i18next": "23.15.1",
    "openapi-fetch": "0.12.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.0.2",
    "react-router-dom": "6.26.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.0",
    "@playwright/test": "1.48.2",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.1",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.4.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.1",
    "yaml": "^2.9.0"
  }
}
