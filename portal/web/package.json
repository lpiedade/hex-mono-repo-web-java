{
  "name": "app-portal-web",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Portal SPA (React, MUI, React Query), served same-origin behind the Spring BFF.",
  "scripts": {
    "generate:api": "openapi-typescript ../bff/src/main/openapi/portal-api-v1.yaml -o src/shared/api/generated/portal-api.d.ts",
    "dev": "vite",
    "prebuild": "npm run generate:api",
    "build": "tsc --noEmit && vite build",
    "pretest": "npm run generate:api",
    "test": "vitest run",
    "pretest:coverage": "npm run generate:api && npm run typecheck",
    "test:coverage": "vitest run --coverage",
    "pretypecheck": "npm run generate:api",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "prelint": "npm run generate:api",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test:a11y": "playwright test --project=a11y",
    "test:journey": "playwright test --project=journey",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@mui/icons-material": "5.18.0",
    "@mui/material": "5.18.0",
    "@tanstack/react-query": "5.104.2",
    "i18next": "23.16.8",
    "openapi-fetch": "0.12.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.7.4",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.13.0",
    "playwright-core": "1.64.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "5.4.21",
    "vitest": "2.1.9",
    "yaml": "^2.9.1"
  }
}
